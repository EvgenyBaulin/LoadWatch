<!doctype html>
<html lang="{{ locale }}">
<head><meta charset="utf-8"><title>{{ title }}</title></head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#1f2329;">
  <table role="presentation" width="100%" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:6px;border-top:4px solid #f46800;">
    <tr><td style="padding:20px 24px;">
      <h1 style="font-size:18px;margin:0 0 12px;">{{ title }}</h1>
      {% for line in lines %}<p style="font-size:14px;line-height:1.5;margin:0 0 8px;">{{ line }}</p>{% endfor %}
      {% if link %}<p style="margin:16px 0 0;"><a href="{{ link }}" style="color:#c24e00;">{{ link_text }}</a></p>{% endif %}
    </td></tr>
  </table>
  <p style="max-width:600px;margin:12px auto 0;font-size:12px;color:#6b7280;">LoadWatch</p>
</body>
</html>
