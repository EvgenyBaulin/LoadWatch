# Демо-цель LoadWatch (demo_target) на 127.0.0.1:8081.
#
# Снаружи доступна через Nginx по HTTPS на отдельном поддомене (deploy/nginx-demo.conf,
# включает bootstrap-server.sh с DEMO_DOMAIN). LoadWatch тестирует её как обычный
# внешний сайт, ALLOW_PRIVATE_TARGETS остаётся false. Без поддомена (только
# 127.0.0.1) её можно тестировать лишь с ALLOW_PRIVATE_TARGETS=true — это отключает
# защиту от SSRF для всех пользователей, на публичном сервере так делать нельзя.
# На одном ядре демо-сайт и генератор делят CPU — цифры демо ориентировочные.
#
# Настройки демо (DEMO_VERIFY_TOKEN, DEMO_CAPACITY_RPS, DEMO_LATENCY_MS …) —
# в необязательном файле /etc/loadwatch/demo.env (права 640, root:loadwatch).
[Unit]
Description=LoadWatch demo target
After=network.target

[Service]
Type=exec
User=loadwatch
Group=loadwatch
WorkingDirectory=/opt/loadwatch
Environment=DEMO_HOST=127.0.0.1
Environment=DEMO_PORT=8081
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/loadwatch/demo.env
ExecStart=/opt/loadwatch/.venv/bin/python -m demo_target
Restart=on-failure
RestartSec=3
MemoryMax=96M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
