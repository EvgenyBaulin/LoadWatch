# Nginx в контейнере фронтенда: SPA + прокси /api/ на контейнер API.
# Это шаблон: при старте контейнера ${API_UPSTREAM} подставляется из окружения
# (стандартный механизм образа nginx, /etc/nginx/templates).
# HTTPS здесь нет: локально он не нужен, в prod-варианте TLS завершает Nginx хоста
# (deploy/nginx-docker.conf).

# Реальный IP клиента. В контейнер приходят только из docker-сети или от Nginx хоста
# (в prod порт опубликован только на 127.0.0.1), поэтому X-Forwarded-For от них доверенный.
set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;

server {
    listen 80;
    listen [::]:80;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;

    root /usr/share/nginx/html;
    index index.html;

    # Сжатие текстовых ответов (статика и JSON API).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json text/csv;

    # CSP (с хэшем inline-скрипта темы) и прочие заголовки. Сгенерировано при сборке.
    # Важно: add_header в location отменяет унаследованные — поэтому include повторяется.
    include /etc/nginx/snippets/security-headers.conf;

    # Встроенный DNS Docker: имя api перерезолвится, если контейнер API пересоздан.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Ровно один адрес: клиентский X-Forwarded-For не пробрасывается дальше,
        # иначе лимиты по IP в API можно было бы обойти подделкой заголовка.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
        # Экспорт PDF/CSV отдаётся сразу клиенту, без буферизации на диск.
        proxy_buffering off;
    }

    # Ассеты Vite с хэшем в имени: меняется содержимое — меняется имя, кэш на год.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html всегда перепроверяется: после деплоя браузер получит новые ассеты.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA: любой неизвестный путь (/sites/123) отдаёт index.html, маршрут решает Vue.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri $uri/ /index.html;
    }
}
